#!/usr/bin/bash

set -euo pipefail

# Calamares runs this inside the installed target, after creating its user.
[[ $# == 1 && $EUID == 0 && $1 =~ ^[a-z_][a-z0-9_-]*$ ]] || exit 2
directory=/opt/agentos
[[ -d $directory && ! -L $directory ]] || exit 1
packages=(agentos-utils agentos-runtime calculet-npu-utils calculet-npu-dkms calculet-npu-firmware)
archives=()
for name in "${packages[@]}"; do
    archive=$directory/$name.pkg.tar.zst
    [[ -f $archive && ! -L $archive ]] || exit 1
    archives+=("$archive")
done
(cd "$directory" && sha256sum --check --strict SHA256SUMS)
AGENTOS_ENABLE_TRANSACTIONS=1 pacman -U --needed --noconfirm -- "${archives[@]}"
/usr/bin/agentos-provision "$1"
# Offline enablement only. Do not start the target's user manager or hardware.
systemctl --no-reload enable agentos-broker-daemon.service
systemctl --global --no-reload enable agentos-daemon.service agentos-model-host.service agentrt.service
rm -- "${archives[@]}" "$directory/SHA256SUMS"
rmdir -- "$directory"
